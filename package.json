{
  "name": "cmc-violations-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منصة إدارة المخالفات – هيئة الإعلام والاتصالات العراقية",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "job:deadlines": "tsx scripts/run-deadlines-job.ts",
    "postinstall": "prisma generate",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:purge": "tsx scripts/purge-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "file-type": "^21.0.0",
    "lucide-react": "0.469.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.20.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
