{
  "name": "admin-work-platform",
  "version": "0.1.0",
  "private": true,
  "description": "نظام إدارة العمل الإداري والتنظيمي",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "job:notifications": "tsx --env-file-if-exists=.env --tsconfig tsconfig.json scripts/run-notifications.ts",
    "postinstall": "prisma generate",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "restore": "tsx --env-file-if-exists=.env --tsconfig tsconfig.json scripts/restore.ts",
    "test:security": "node tests/e2e/security.cjs",
    "password:hash": "tsx scripts/hash-password.ts",
    "bootstrap": "tsx --env-file-if-exists=.env --tsconfig tsconfig.json scripts/bootstrap.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "exceljs": "^4.4.0",
    "lucide-react": "0.469.0",
    "next": "15.5.28",
    "playwright-core": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.20.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "playwright": "1.63.0"
  }
}
