# قاعدة البيانات المركزية (PostgreSQL 14 أو أحدث)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/admin_work"
# الرابط المباشر لتشغيل الترحيلات (يساوي DATABASE_URL إن لم يوجد مجمّع اتصالات)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/admin_work"
# سر التطبيق: 32 حرفاً عشوائياً على الأقل (openssl rand -base64 48)
APP_SECRET=""
# مدة الجلسة بالساعات (الافتراضي 8)، وتنتهي أيضاً بعد 60 دقيقة خمول
SESSION_TTL_HOURS=8
# المنطقة الزمنية للعرض
APP_TIMEZONE="Asia/Baghdad"
# قاعدة الاختبار (يجب أن يحتوي اسمها كلمة test)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/admin_work_test"
# مسار متصفح Chromium لتوليد تقارير PDF على الخادم (اختياري). بدونه تبقى الطباعة والحفظ PDF من المتصفح متاحة.
CHROMIUM_PATH=""
# سر المهمة المجدولة للتنبيهات (16 حرفاً على الأقل): يُرسل في الترويسة Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# مفتاح تشفير النسخ الاحتياطية (32 بايت: openssl rand -base64 32). احفظه خارج الخادم؛ بدونه لا تُستعاد النسخ.
BACKUP_KEY=""
# مجلد النسخ وعدد النسخ المحتفظ بها
BACKUP_DIR="./backups"
BACKUP_KEEP=30
