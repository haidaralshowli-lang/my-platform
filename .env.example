# ───── قاعدة البيانات (PostgreSQL) ─────
# في Supabase: استخدم رابط Pooler (المنفذ 6543 مع ?pgbouncer=true) لـ DATABASE_URL
# والرابط المباشر (المنفذ 5432) لـ DIRECT_DATABASE_URL لتشغيل الترحيلات.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cmc_violations"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cmc_violations"

# ───── التطبيق ─────
# العنوان العام للمنصة (يُستخدم للتحقق من مصدر الطلبات)
APP_URL="http://localhost:3000"
# المنطقة الزمنية الافتراضية للاحتساب والعرض
APP_TIMEZONE="Asia/Baghdad"
# مدة الجلسة بالساعات
SESSION_TTL_HOURS="8"
# مفتاح سري عشوائي طويل (32 بايت على الأقل) لتجزئة رموز المهام المجدولة وغيرها
APP_SECRET="replace-with-long-random-secret"

# ───── تخزين الملفات ─────
# local: مجلد خاص خارج public (للتطوير والخوادم الداخلية)
# s3: أي تخزين متوافق مع S3 (MinIO، Supabase Storage، تخزين مؤسسي)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# فحص اختياري بمضاد برمجيات خبيثة (خدمة clamd)
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# ───── المهام المجدولة ─────
# رمز يُرسل في ترويسة الطلب لتشغيل مهمة تحديث المدد يدوياً أو من مجدول خارجي
CRON_SECRET="replace-with-long-random-secret"
